# 複製成 .env 或直接設定為系統環境變數（.env 已被 .gitignore 排除）
# 不設定金鑰時，app.py 第一次啟動會自動產生並存到 server/.localbot_secrets.json
#
# v3.0 起支援多個 Bot：Bot 與其金鑰、Webhook 網址都在管理後台（/admin →「Bot 與邀請碼」）建立與管理。
# 下面的 CHANNEL_SECRET / CHANNEL_ACCESS_TOKEN / BOT_WEBHOOK_URL 只用來在「第一次啟動」時建立「預設 Bot」，
# 之後修改請到後台。手機 App 不再使用共用的 APP_SECRET，而是用後台產生的邀請碼加入，每支手機各有自己的金鑰。

LOCALBOT_SERVER_URL=https://your-domain.example.com
LOCALBOT_HOST=0.0.0.0
LOCALBOT_PORT=5003
LOCALBOT_BOT_WEBHOOK_URL=http://localhost:9000/callback

# 預設 Bot：平台 → Bot 的 Webhook 簽名（只給 Bot 程式）
LOCALBOT_CHANNEL_SECRET=
# 預設 Bot：Bot → 平台 API 的 Bearer Token（只給 Bot 程式）
LOCALBOT_CHANNEL_ACCESS_TOKEN=

LOCALBOT_DEBUG=false
LOCALBOT_MAX_UPLOAD_MB=20
LOCALBOT_CORS_ORIGINS=*

# Webhook 轉送失敗時，每次重試前等待的秒數（逗號分隔）；留空 = 不自動重試
LOCALBOT_WEBHOOK_RETRY_DELAYS=10,60,300,1800
LOCALBOT_WEBHOOK_TIMEOUT=15
# Webhook 日誌與排程執行紀錄保留天數
LOCALBOT_LOG_RETENTION_DAYS=30
# 排程錯過超過幾分鐘就不補送
LOCALBOT_SCHEDULE_GRACE_MINUTES=60
# false = 不啟動背景工作（不重試 webhook、不跑排程）
LOCALBOT_WORKERS_ENABLED=true

# AI 產生的排程訊息（擇一，也可以在後台「設定 → AI 金鑰」輸入）
# LOCALBOT_ANTHROPIC_API_KEY=
# LOCALBOT_OPENAI_API_KEY=
