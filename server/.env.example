# 複製成 .env 或直接設定為系統環境變數（.env 已被 .gitignore 排除）
# 不設定三組金鑰時，app.py 第一次啟動會自動產生並存到 server/.localbot_secrets.json

LOCALBOT_SERVER_URL=https://your-domain.example.com
LOCALBOT_HOST=0.0.0.0
LOCALBOT_PORT=5003
LOCALBOT_BOT_WEBHOOK_URL=http://localhost:9000/callback

# 平台 → Bot 的 Webhook 簽名（只給 Bot 程式）
LOCALBOT_CHANNEL_SECRET=
# Bot → 平台 API 的 Bearer Token（只給 Bot 程式）
LOCALBOT_CHANNEL_ACCESS_TOKEN=
# 手機 App → 平台 的簽名金鑰（填在 App 設定頁）
LOCALBOT_APP_SECRET=

LOCALBOT_DEBUG=false
LOCALBOT_MAX_UPLOAD_MB=20
LOCALBOT_CORS_ORIGINS=*
